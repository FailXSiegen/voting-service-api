{
  "name": "voting-service-api",
  "version": "3.0.0",
  "description": "Voting service API",
  "scripts": {
    "serve": "babel-watch ./src",
    "dev": "babel-watch ./src",
    "copy": "cp -avr src/lib/emails/ dist/lib/",
    "build": "babel src --out-dir dist && npm run copy",
    "db:migrate": "node_modules/.bin/db-migrate up",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js",
    "lint": "eslint --fix src",
    "lint:check": "eslint src",
    "format": "prettier src --write",
    "format:check": "prettier src --check",
    "lint:debug": "bash bin/find-forbidden-words.sh",
    "qa": "npm run lint:check && npm run format:check && npm run lint:debug",
    "test:mail": "node scripts/smoke-mail.js",
    "qa:cpd": "jscpd src",
    "qa:unused": "knip",
    "qa:all": "npm run qa && npm run qa:cpd && npm run qa:unused",
    "before:commit": "npm run lint:check && npm run lint:debug && npm run format:check",
    "prepare": "husky",
    "setup-testdata": "babel-node scripts/test-setup.js",
    "clear-shortlinks": "babel-node src/scripts/clear-shortlinks.js"
  },
  "keywords": [],
  "author": "Wolf Utz",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.11.6",
    "apollo-errors": "^1.9",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "db-migrate": "^1.8.1",
    "db-migrate-mysql": "^3.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "fast-csv": "^5.0.8",
    "graphql-ws": "^6.4.1",
    "graphql-yoga": "^6.0.1",
    "humps": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "minimist": "^1.2.5",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "nodemailer-pug-engine": "^2.0.1",
    "promise-mysql": "^5.2.0",
    "uuid": "^14.0.3",
    "ws": "^8.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.14.5",
    "@babel/node": "^7.10.5",
    "@babel/preset-env": "^7.11.0",
    "@eslint/js": "^10.0.1",
    "babel-plugin-import-graphql": "^2.7.0",
    "babel-watch": "^7.8.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "4.0.8",
    "knip": "^6.3.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.0"
  },
  "overrides": {
    "cross-undici-fetch": "0.4.8",
    "qs": "^6.16.0",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "engines": {
    "npm": ">=9.0.0",
    "node": ">=22.0.0"
  }
}
